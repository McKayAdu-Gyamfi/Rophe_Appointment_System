# Copy to .env and fill in real values. Never commit .env
PORT=4000
CLIENT_URL="http://localhost:3000"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rophe?schema=public"

# Signs the session cookie. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to boot in production if this is still a dev placeholder.
SESSION_SECRET="dev-only-secret-replace-in-every-real-environment"
SESSION_DAYS=7

# Messaging. `noop` logs instead of sending, so the whole app works end to end
# before any provider contract is signed. Switch once a provider is live.
MESSAGE_PROVIDER=noop
WHATSAPP_API_TOKEN=
SMS_API_KEY=
EMAIL_API_KEY=
